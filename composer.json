{
  "name": "larasell/larasell",
  "description": "A e-commerce package built on top of Laravel",
  "type": "library",
  "license": "MIT",
  "version": "1.0.0",	
  "authors": [
    {
      "name": "Nils Haberkamp",
      "email": "haberkamp.n@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Larasell\\Larasell\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Larasell\\Larasell\\Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Larasell\\Larasell\\LarasellServiceProvider"
      ]
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.1",
    "laravel/pint": "^1.0"
  },
  "require": {
    "ext-bcmath": "*",
    "ext-intl": "*",
    "inertiajs/inertia-laravel": "^3.0"
  },
  "scripts": {
    "pest": "pest tests/Unit tests/Feature tests/Admin",
    "pint": "pint",
    "test": "@pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
