{
  "name": "larasell-dev/larasell",
  "description": "An e-commerce package built on top of Laravel",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Nils Haberkamp",
      "email": "nils@larasell.dev"
    }
  ],
  "autoload": {
    "psr-4": {
      "Larasell\\Larasell\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Larasell\\Larasell\\Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Larasell\\Larasell\\LarasellServiceProvider"
      ]
    }
  },
  "require-dev": {
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.1",
    "laravel/pint": "^1.0",
    "laravel/pao": "^1.1"
  },
  "require": {
    "ext-bcmath": "*",
    "ext-intl": "*",
    "inertiajs/inertia-laravel": "^3.0"
  },
  "scripts": {
    "pest": "pest tests/Unit tests/Feature tests/Admin tests/Concurrency",
    "pint": "pint",
    "test": "@pest"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
