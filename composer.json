{
  "name": "larasell-dev/larasell",
  "description": "An e-commerce package built on top of Laravel",
  "keywords": [
    "commerce",
    "e-commerce",
    "ecommerce",
    "laravel",
    "laravel-package",
    "shop"
  ],
  "homepage": "https://larasell.dev",
  "type": "library",
  "license": "proprietary",
  "authors": [
    {
      "name": "Nils Haberkamp",
      "email": "nils@larasell.dev"
    }
  ],
  "support": {
    "email": "nils@larasell.dev",
    "issues": "https://github.com/Larasell-dev/larasell/issues",
    "source": "https://github.com/Larasell-dev/larasell",
    "docs": "https://larasell.dev"
  },
  "autoload": {
    "psr-4": {
      "Larasell\\Larasell\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Larasell\\Larasell\\Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Larasell\\Larasell\\LarasellServiceProvider"
      ]
    }
  },
  "require-dev": {
    "inertiajs/inertia-laravel": "^3.0",
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.1",
    "laravel/pint": "^1.0",
    "laravel/pao": "^1.1"
  },
  "require": {
    "ext-bcmath": "*",
    "ext-intl": "*",
    "laravel/framework": "^13.23",
    "php": "^8.3"
  },
  "suggest": {
    "inertiajs/inertia-laravel": "Required when using the optional Larasell admin panel."
  },
  "scripts": {
    "pest": "pest tests --parallel",
    "pest:ci": "pest tests --parallel --processes=4",
    "phpstan": "phpstan analyse",
    "pint": "pint",
    "test": "@pest"
  },
  "archive": {
    "exclude": [
      "/.build",
      "/.github",
      "/.gitignore",
      "/.phpunit.result.cache",
      "/.release-please-manifest.json",
      "/composer.lock",
      "/docs",
      "/node_modules",
      "/package-lock.json",
      "/package.json",
      "/phpstan.neon",
      "/phpunit.xml",
      "/release-please-config.json",
      "/tests",
      "/tsconfig.json",
      "/vendor",
      "/version.txt",
      "/vite.config.ts"
    ]
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
